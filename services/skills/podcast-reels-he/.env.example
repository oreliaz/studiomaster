# Qwen-Image (Alibaba Model Studio / DashScope) creds — ONLY needed for premium b-roll.
# Copy this file to `.env` (same folder) and fill in. Simple style needs none of this.
#
# Use a DEFAULT-workspace key; a sub-workspace key fails with AccessDenied.Unpurchased
# unless the root admin authorizes each image model.
QWEN_API_KEY=sk-...
QWEN_DASHSCOPE_BASE=https://dashscope-intl.aliyuncs.com/api/v1
# Optional: override the image model (default qwen-image-2.0-pro)
# QWEN_IMAGE_MODEL=qwen-image-2.0-pro
