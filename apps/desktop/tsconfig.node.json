{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron-vite/node"],
    "paths": {
      "@studiomaster/shared": ["../../packages/shared/src/index.ts"],
      "@studiomaster/obs-controller": ["../../packages/obs-controller/src/index.ts"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "electron.vite.config.ts",
    "../../packages/shared/src/**/*.ts",
    "../../packages/obs-controller/src/**/*.ts"
  ]
}
