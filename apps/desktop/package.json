{
  "name": "@studiomaster/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "StudioMaster desktop app (Electron + React) — UI and orchestrator",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@studiomaster/lighting": "*",
    "@studiomaster/obs-controller": "*",
    "@studiomaster/ptz-control": "*",
    "@studiomaster/shared": "*",
    "@studiomaster/studio-launcher": "*",
    "googleapis": "^144.0.0",
    "obs-websocket-js": "^5.0.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^31.7.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8"
  }
}
